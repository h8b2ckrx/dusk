# Chunk B of docs/inventory-shell.md: notifications, message list, calendar,
# OSDs, Shell controls. Same format as chunk-a.selectors ("~" = not shown by
# the probe's UI states, but must still be in our stylesheet).
.notification-banner
.message
.message-view .message
~.notification-button
~.message-media-control
